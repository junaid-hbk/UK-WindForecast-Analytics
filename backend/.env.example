# ── database ──────────────────────────────────────────────────────────────
# Never commit real credentials. Copy this file to .env and edit locally.
DATABASE_URL=mysql+pymysql://windpulse:windpulse_pw@127.0.0.1:3307/windpulse?charset=utf8mb4

# ── application ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Elexon BMRS (public API: no key is required) ──────────────────────────
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_READ_TIMEOUT_SECONDS=30
ELEXON_MAX_ATTEMPTS=4
ELEXON_BACKOFF_BASE_SECONDS=0.5
ELEXON_BACKOFF_MAX_SECONDS=8
ELEXON_ACTUAL_CHUNK_DAYS=7
ELEXON_FORECAST_CHUNK_DAYS=1
ELEXON_USER_AGENT=WindPulseUK/0.2

# ── analysis ──────────────────────────────────────────────────────────────
DEFAULT_CUTOFF_POLICY_CODE=EPEX_GB_DA_1H_0920
WINDFOR_SP_MAPPING=step
MAX_QUERY_DAYS=180

# ── HTTP ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to disable the /api/v1/admin/* endpoints entirely.
ADMIN_TOKEN=
PAGE_SIZE_DEFAULT=500
PAGE_SIZE_MAX=5000

# ── test database (used by pytest only) ───────────────────────────────────
TEST_DATABASE_URL=mysql+pymysql://windpulse:windpulse_pw@127.0.0.1:3307/windpulse_test?charset=utf8mb4
